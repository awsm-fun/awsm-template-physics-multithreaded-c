{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_COLOR_DIAGNOSTICS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (with sanitizers)",
      "description": "Native build for tests and the headless run, with AddressSanitizer + UBSan.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (optimized)",
      "description": "Native optimized build (LTO when available).",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "wasm",
      "displayName": "WebAssembly (Emscripten)",
      "description": "Optimized (-O3) browser build: build/wasm/app.js + app.wasm. `task app:release` builds it and copies it into dist/app/.",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/EmscriptenToolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "wasm-dev",
      "displayName": "WebAssembly dev (Emscripten, debug)",
      "description": "Fast-linking -O0 browser build with runtime assertions: build/wasm-dev/app.js + app.wasm. `task app:dev` builds it and copies it into dist/app/.",
      "inherits": "wasm",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "wasm",
      "configurePreset": "wasm"
    },
    {
      "name": "wasm-dev",
      "configurePreset": "wasm-dev"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "wasm",
      "configurePreset": "wasm",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "steps": [
        {
          "type": "configure",
          "name": "debug"
        },
        {
          "type": "build",
          "name": "debug"
        },
        {
          "type": "test",
          "name": "debug"
        }
      ]
    },
    {
      "name": "release",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        }
      ]
    },
    {
      "name": "wasm",
      "steps": [
        {
          "type": "configure",
          "name": "wasm"
        },
        {
          "type": "build",
          "name": "wasm"
        },
        {
          "type": "test",
          "name": "wasm"
        }
      ]
    }
  ]
}
